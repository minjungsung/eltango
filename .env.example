# =============================================================================
# Google Sheets backend (via Apps Script web app)
# See SETUP_GOOGLE_SHEETS.md for the full walkthrough.
# =============================================================================

# Google Apps Script web app URL (from Deploy → Web app).
# This must stay server-side only — do NOT prefix with NEXT_PUBLIC_.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# KakaoTalk open chat room URL — redirects user after successful submission.
NEXT_PUBLIC_KAKAO_OPENCHAT_URL=https://open.kakao.com/o/gzAMRBrg

# =============================================================================
# Naver Maps JavaScript API
# Get a client ID at https://console.ncloud.com/naver-service/application
# Service: Web Dynamic Map, Web service URL: your domain (e.g. eltango.vercel.app)
# =============================================================================
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=YOUR_CLIENT_ID_HERE
