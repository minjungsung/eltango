# =============================================================================
# Google Forms backend (no OAuth / no Apps Script required)
# See SETUP_GOOGLE_FORMS.md for the full walkthrough.
# =============================================================================

# Option A: paste just the form ID (the long code in your form URL)
# From e.g. https://docs.google.com/forms/d/e/1FAIpQLSdq.../viewform
GOOGLE_FORM_ID=1FAIpQLSdqxyTy_5SwYwzzmRQC3-nyWK0kmvQr8ue6MVLbYXeUdp57vQ

# Option B (alternative): paste the full form URL instead of the ID.
# Either viewform or formResponse URL works.
# GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/XXXX/viewform

# Entry IDs for each form field (required for name + phone, others optional).
# Find these in the "Get pre-filled link" URL — see SETUP_GOOGLE_FORMS.md.
GOOGLE_FORM_ENTRY_NAME=1234567890
GOOGLE_FORM_ENTRY_PHONE=1234567890
GOOGLE_FORM_ENTRY_MEMO=
GOOGLE_FORM_ENTRY_SOURCE=
GOOGLE_FORM_ENTRY_CONSENT=

# KakaoTalk open chat room URL to redirect to after a successful submission.
# Example: https://open.kakao.com/o/xxxxxxx
NEXT_PUBLIC_KAKAO_OPENCHAT_URL=https://open.kakao.com/o/REPLACE_ME
