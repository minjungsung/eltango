# Google Apps Script Web App URL (POST endpoint)
# See SETUP_GOOGLE_SHEETS.md for how to get this value.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXX/exec

# KakaoTalk open chat room URL to redirect to after a successful submission.
